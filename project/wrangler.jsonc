{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "pitchyes-site",
	// Conta Cloudflare do Matheus (migrada da conta do Borges em 2026-11-12). Fixar a conta aqui
	// impede que o deploy vá para outra conta quando o login enxerga mais de uma.
	"account_id": "a4549f771a9c29c3db10fdc325f8c99b",
	"compatibility_date": "2026-09-17",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": { "enabled": true },
	"services": [
		// Self-reference must match the worker name (https://opennext.js.org/cloudflare/caching)
		{ "binding": "WORKER_SELF_REFERENCE", "service": "pitchyes-site" }
	],
	"r2_buckets": [
		{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "pitchyes-site-opennext-cache" },
		// Imagens enviadas pelo painel (compartilhamento social). Servidas em /midia/*.
		{ "binding": "MEDIA_BUCKET", "bucket_name": "pitchyes-site-midia" }
	],
	"images": { "binding": "IMAGES" },
	// Banco do site: leads, painel, Page Editor e blog (see src/lib/leads.ts and /admin).
	// "remote": true faz o BUILD (e o next dev) lerem o D1 real: as páginas que dependem do
	// banco — blog, metadados do Page Editor — já saem do build com o conteúdo publicado, em
	// vez de vazias até a primeira revalidação. Atenção: o next dev local grava em produção.
	"d1_databases": [
		{ "binding": "LEADS_DB", "database_name": "pitchyes-leads", "database_id": "63c7fe8f-bd2e-407e-babd-da95e5ec9a4d", "remote": true },
		// Cache de tags do OpenNext (revalidatePath): mesma base, tabela própria `revalidations`.
		{ "binding": "NEXT_TAG_CACHE_D1", "database_name": "pitchyes-leads", "database_id": "63c7fe8f-bd2e-407e-babd-da95e5ec9a4d", "remote": true }
	],
	// ADMIN_AUTH_MODE: "session" (login por e-mail e senha) ou "basic" (senha única
	// antiga, ADMIN_PASSWORD) — válvula de escape se o login novo falhar.
	// ADMIN_MAIL_MODE: "live" | "test" | "console" (ver src/lib/admin/mail.ts).
	"vars": {
		"SITE_ENV": "production",
		"ADMIN_AUTH_MODE": "session",
		"ADMIN_MAIL_MODE": "live",
		// Provisório: pitchyes.com.br ainda não está verificado na Resend (DNS fora da
		// nossa conta). bmidias.b300.com.br já está, então os e-mails do painel saem de
		// lá e chegam a qualquer caixa. Quando o DNS de pitchyes.com.br for verificado,
		// troque só este valor para nao-responda@pitchyes.com.br.
		"ADMIN_MAIL_FROM": "PitchYes <nao-responda@bmidias.b300.com.br>"
	},
	// SITE_URL (the public domain) is managed in the Cloudflare dashboard, not here;
	// keep_vars stops deploys from wiping dashboard-set variables.
	"keep_vars": true,

	"env": {
		"preview": {
			"name": "pitchyes-site-preview",
			"services": [
				{ "binding": "WORKER_SELF_REFERENCE", "service": "pitchyes-site-preview" }
			],
			"r2_buckets": [
				{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "pitchyes-site-preview-opennext-cache" },
				{ "binding": "MEDIA_BUCKET", "bucket_name": "pitchyes-site-midia" }
			],
			"images": { "binding": "IMAGES" },
			// Same leads database as production — the preview worker is only used for smoke tests.
			"d1_databases": [
				{ "binding": "LEADS_DB", "database_name": "pitchyes-leads", "database_id": "63c7fe8f-bd2e-407e-babd-da95e5ec9a4d" },
				{ "binding": "NEXT_TAG_CACHE_D1", "database_name": "pitchyes-leads", "database_id": "63c7fe8f-bd2e-407e-babd-da95e5ec9a4d" }
			],
			"vars": { "SITE_ENV": "preview", "ADMIN_AUTH_MODE": "session", "ADMIN_MAIL_MODE": "console" }
		}
	}
}
